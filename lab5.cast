[2494.534034, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[3d"]
[2494.534461, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m requests\r\u001b[4d"]
[2494.534873, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m requests.auth \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m HTTPBasicAuth\r\u001b[5d"]
[2494.535308, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m json\r\u001b[7d"]
[2494.535785, "o", "\u001b(B\u001b[0;1m\u001b[31m# Configure logging\r\u001b[8d"]
[2494.536215, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(level=logging.INFO, format=\u001b(B\u001b[0;1m\u001b[32m'%(name)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[10d"]
[2494.536768, "o", "\u001b(B\u001b[0;1m\u001b[31m# Host and credentials\r\u001b[11d"]
[2494.537199, "o", "\u001b[39m\u001b(B\u001b[mHOST = \u001b(B\u001b[0;1m\u001b[32m'192.168.1.101'\r\u001b[12d"]
[2494.537672, "o", "\u001b[39m\u001b(B\u001b[mUSER = \u001b(B\u001b[0;1m\u001b[32m'student'\r\u001b[13d"]
[2494.538095, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\r\u001b[14d"]
[2494.538562, "o", "\u001b[39m\u001b(B\u001b[mBASE_URL = \u001b(B\u001b[0;1m\u001b[32m'http://{0}/restconf/api/running/'\u001b[39m\u001b(B\u001b[m.format(HOST)\r\u001b[16d"]
[2494.538995, "o", "\u001b(B\u001b[0;1m\u001b[31m# Function to set interface\r\u001b[17d"]
[2494.53944, "o", "\u001b[36mdef\u001b[34m set_interfaces\u001b[39m\u001b(B\u001b[m(append_url, interface_name):\u001b[18;5H"]
[2494.539852, "o", "url = BASE_URL + append_url + interface_name\u001b[19;5H"]
[2494.54033, "o", "auth = HTTPBasicAuth(USER, PASS)\u001b[20;5H"]
[2494.540748, "o", "headers = {\u001b[21;9H"]
