[2821.130468, "o", "\u001b[42m    \u001b[28d\b"]
[2821.130901, "o", "\u001b(B\u001b[0;1m\u001b[31m # Data payload for configuring the interface\u001b[29;5H"]
[2821.131372, "o", "\u001b[39m\u001b(B\u001b[mdata = {\u001b[30;9H"]
[2821.131776, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-interfaces:interface\"\u001b[39m\u001b(B\u001b[m: {\u001b[31;13H"]
[2821.132204, "o", "\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"GigabitEthernet3\"\u001b[39m\u001b(B\u001b[m,\u001b[32;13H"]
[2821.132627, "o", "\u001b(B\u001b[0;1m\u001b[32m\"description\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"Changed through Restconf\"\u001b[39m\u001b(B\u001b[m,\u001b[33;13H"]
[2821.13305, "o", "\u001b(B\u001b[0;1m\u001b[32m\"type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"iana-if-type:ethernetCsmacd\"\u001b[39m\u001b(B\u001b[m,\u001b[34;13H"]
[2821.13346, "o", "\u001b(B\u001b[0;1m\u001b[32m\"enabled\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'true'\u001b[39m\u001b(B\u001b[m,\u001b[35;13H"]
[2821.133902, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-ip:ipv4\"\u001b[39m\u001b(B\u001b[m: {\u001b[36;17H"]
