[2149.253575, "o", "\u001b(B\u001b[m"]
[2149.254153, "o", "\r\u001b[50d"]
[2149.254666, "o", "\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Get Help   \u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out  \u001b(B\u001b[0;7m^W\u001b(B\u001b[m Where Is   \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut Text   \u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify    \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Cur Pos    \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\r\u001b[51d"]
[2149.255097, "o", "\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[15G"]
[2149.255537, "o", "\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File  \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace    \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste Text \u001b(B\u001b[0;7m^T\u001b(B\u001b[m To Spell   \u001b(B\u001b[0;7m^_\u001b(B\u001b[m Go To Line \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\r\u001b[49d"]
[2149.257928, "o", "\u001b[2d"]
[2149.258419, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\u001b[42m \r\u001b[3d"]
[2149.258867, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m requests\u001b[42m \r\u001b[4d"]
[2149.259356, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m requests.auth \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m HTTPBasicAuth\u001b[42m \r\u001b[5d"]
[2149.259776, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m json\u001b[42m \r\u001b[7d"]
[2149.26017, "o", "\u001b[49m\u001b(B\u001b[mlogging.basicConfig(level=logging.INFO, format=\u001b(B\u001b[0;1m\u001b[32m'%(name)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\u001b[42m \r\u001b[9d"]
[2149.260594, "o", "\u001b[49m\u001b(B\u001b[mHOST = \u001b(B\u001b[0;1m\u001b[32m'192.168.1.101'\u001b(B\u001b[0m\u001b[42m \r\u001b[10d"]
[2149.260988, "o", "\u001b[49m\u001b(B\u001b[mUSER = \u001b(B\u001b[0;1m\u001b[32m'student'\u001b(B\u001b[0m\u001b[42m \r\u001b[11d"]
[2149.261405, "o", "\u001b[49m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\u001b(B\u001b[0m\u001b[42m \r\u001b[12d"]
[2149.261801, "o", "\u001b[49m\u001b(B\u001b[mBASE_URL = \u001b(B\u001b[0;1m\u001b[32m'http://{0}/restconf/api/running/'\u001b[39m\u001b(B\u001b[m.format(HOST)\u001b[42m \r\u001b[14d"]
[2149.262221, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m set_interfaces\u001b[39m\u001b(B\u001b[m(append_url, interface_name):\u001b[42m \u001b[15;5H"]
[2149.26264, "o", "\u001b[49m\u001b(B\u001b[murl = BASE_URL + append_url + interface_name\u001b[42m \u001b[16;5H"]
[2149.263049, "o", "\u001b[49m\u001b(B\u001b[mauth = HTTPBasicAuth(USER, PASS)\u001b[42m \u001b[17;5H"]
[2149.263437, "o", "\u001b[49m\u001b(B\u001b[mheaders = {\u001b[18d"]
[2149.263855, "o", "\u001b(B\u001b[0;1m\u001b[32m'Accept'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[39m\u001b(B\u001b[m,\u001b[19;16H"]
[2149.264256, "o", "\u001b(B\u001b[0;1m\u001b[32m'Content-Type'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[20;15H"]
[2149.264672, "o", "\u001b[39m\u001b(B\u001b[m}\u001b[21;5H"]
[2149.26506, "o", "data = {\u001b[22d"]
[2149.265494, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-interfaces:interface\"\u001b[39m\u001b(B\u001b[m: {\u001b[23;13H"]
[2149.265913, "o", "\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"GigabitEthernet3\"\u001b[39m\u001b(B\u001b[m,\u001b[24;13H"]
[2149.266361, "o", "\u001b(B\u001b[0;1m\u001b[32m\"description\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"Changed through Restconf\"\u001b[39m\u001b(B\u001b[m,\u001b[42m \u001b[25;13H"]
[2149.266762, "o", "\u001b(B\u001b[0;1m\u001b[32m\"type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"iana-if-type:ethernetCsmacd\"\u001b[39m\u001b(B\u001b[m,\u001b[42m \u001b[26;13H"]
[2149.267182, "o", "\u001b(B\u001b[0;1m\u001b[32m\"enabled\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'true'\u001b[39m\u001b(B\u001b[m,\u001b[27;13H"]
[2149.267573, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-ip:ipv4\"\u001b[39m\u001b(B\u001b[m: {\u001b[28;17H"]
[2149.267983, "o", "\u001b(B\u001b[0;1m\u001b[32m\"address\"\u001b[39m\u001b(B\u001b[m: [\u001b[29;21H"]
[2149.268373, "o", "{\u001b[30d  "]
[2149.268798, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ip\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"10.0.10.3\"\u001b[39m\u001b(B\u001b[m,\u001b[42m \u001b[31;24H"]
[2149.269209, "o", "\u001b(B\u001b[0;1m\u001b[32m\"netmask\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"255.255.255.0\"\u001b(B\u001b[0m\u001b[42m \u001b[32;21H"]
[2149.269626, "o", "\u001b[49m\u001b(B\u001b[m}\u001b[33;17H"]
[2149.269881, "o", "]\u001b[34;14H"]
[2149.270138, "o", "},\u001b[35d\b\b"]
[2149.270753, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-ip:ipv6\"\u001b[39m\u001b(B\u001b[m: {}\u001b[36;16H"]
[2149.271013, "o", "}\u001b[37;12H"]
[2149.271315, "o", "}\u001b[38;7H"]
[2149.271571, "o", "response = requests.put(url, auth=auth, headers=headers,\u001b[42m \u001b[39;3H"]
[2149.271837, "o", "\u001b[49m\u001b(B\u001b[mdata=json.dumps(data))\u001b[42m \u001b[40;5H"]
[2149.272069, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m response.status_code == 204:\u001b[42m \u001b[41;9H"]
[2149.27234, "o", "\u001b[49m\u001b(B\u001b[mlogging.info(f\u001b(B\u001b[0;1m\u001b[32m\"Request was successful on {HOST}, Code: {response.status_code}\"\u001b[39m\u001b(B\u001b[m)\u001b[42m \u001b[42;9H"]
[2149.2726, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[32m\"success!\"\u001b(B\u001b[0m\u001b[42m \u001b[43;4H"]
[2149.272915, "o", "\u001b(B\u001b[0;1m\u001b[36melse\u001b[39m\u001b(B\u001b[m:\u001b[42m \u001b[44d\b"]
[2149.273951, "o", "\u001b[49m\u001b(B\u001b[mlogging.error(f\u001b(B\u001b[0;1m\u001b[32m\"Error encountered during request on {HOST}, Code: {response.status_code}\"\u001b[39m\u001b(B\u001b[m)\u001b[42m \u001b[45;10H"]
[2149.274234, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m response.text\u001b[42m \r\u001b[46d"]
[2149.274524, "o", "\u001b(B\u001b[0;1m\u001b[36mprint \u001b[39m\u001b(B\u001b[m(set_interfaces(\u001b(B\u001b[0;1m\u001b[32m\"interfaces/interface/\"\u001b[39m\u001b(B\u001b[m, \u001b(B\u001b[0;1m\u001b[32m\"GigabitEthernet3\"\u001b[39m\u001b(B\u001b[m))\r\u001b[2d"]
