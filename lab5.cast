[2073.41361, "o", "\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"GigabitEthernet3\"\u001b[39m\u001b(B\u001b[m,\u001b[42m \u001b[24;13H"]
