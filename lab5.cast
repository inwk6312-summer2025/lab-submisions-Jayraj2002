[1679.723933, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\r\u001b[10d"]
[1679.724336, "o", "\u001b[39m\u001b(B\u001b[mBASE_URL = \u001b(B\u001b[0;1m\u001b[32m'http://{0}/restconf/api/running/'\u001b[39m\u001b(B\u001b[m.format(HOST)\r\u001b[11d"]
[1679.724769, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m get_interfaces\u001b[39m\u001b(B\u001b[m(append_url, interface_name):\r\u001b[12d"]
[1679.725203, "o", "url = BASE_URL + append_url + interface_name\r\u001b[13d"]
[1679.725585, "o", "auth = HTTPBasicAuth(USER, PASS)\r\u001b[14d"]
[1679.725983, "o", "headers = {\u001b(B\u001b[0;1m\u001b[32m'Accept'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[39m\u001b(B\u001b[m}\r\u001b[15d"]
[1679.7264, "o", "params = {\u001b(B\u001b[0;1m\u001b[32m'deep'\u001b[39m\u001b(B\u001b[m:\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m}\r\u001b[16d"]
[1679.72682, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"URL ==> {url}\"\u001b[39m\u001b(B\u001b[m)\r\u001b[17d"]
[1679.727212, "o", "response = requests.get(url, auth=auth, headers=headers, params=params)\r\u001b[18d"]
[1679.727591, "o", "\u001b(B\u001b[0;1m\u001b[36mif\u001b[39m\u001b(B\u001b[m response.status_code == 200:\r\u001b[19d"]
[1679.728003, "o", "logging.info(f\u001b(B\u001b[0;1m\u001b[32m\"Request was successful on {HOST}, Code: {response.status_code}\"\u001b[39m\u001b(B\u001b[m)\r\u001b[20d"]
[1679.728397, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m json.dumps(response.json(), sort_keys=\u001b(B\u001b[0;1m\u001b[35mTrue\u001b[39m\u001b(B\u001b[m, indent=4 )\r\u001b[21d"]
[1679.728813, "o", "\u001b(B\u001b[0;1m\u001b[36melse\u001b[39m\u001b(B\u001b[m:\r\u001b[22d"]
[1679.729213, "o", "logging.error(f\u001b(B\u001b[0;1m\u001b[32m\"Error encountered during request on {HOST}, Code: {response.status_code}\"\u001b[39m\u001b(B\u001b[m)\r\u001b[23d"]
[1679.729578, "o", "\u001b(B\u001b[0;1m\u001b[36mreturn\u001b[39m\u001b(B\u001b[m response.text\r\u001b[24d"]
