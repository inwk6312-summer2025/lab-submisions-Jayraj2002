[2821.12065, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m logging\r\u001b[3d"]
[2821.121101, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m requests\r\u001b[4d"]
[2821.121523, "o", "\u001b(B\u001b[0;1m\u001b[36mfrom\u001b[39m\u001b(B\u001b[m requests.auth \u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m HTTPBasicAuth\r\u001b[5d"]
[2821.121956, "o", "\u001b(B\u001b[0;1m\u001b[36mimport\u001b[39m\u001b(B\u001b[m json\r\u001b[7d"]
[2821.122431, "o", "\u001b(B\u001b[0;1m\u001b[31m# Configure logging\r\u001b[8d"]
[2821.122887, "o", "\u001b[39m\u001b(B\u001b[mlogging.basicConfig(level=logging.INFO, format=\u001b(B\u001b[0;1m\u001b[32m'%(name)s - %(levelname)s - %(message)s'\u001b[39m\u001b(B\u001b[m)\r\u001b[10d"]
[2821.123346, "o", "\u001b(B\u001b[0;1m\u001b[31m# Host and credentials\r\u001b[11d"]
[2821.123747, "o", "\u001b[39m\u001b(B\u001b[mHOST = \u001b(B\u001b[0;1m\u001b[32m'192.168.1.101'\r\u001b[12d"]
[2821.124162, "o", "\u001b[39m\u001b(B\u001b[mUSER = \u001b(B\u001b[0;1m\u001b[32m'student'\r\u001b[13d"]
[2821.124622, "o", "\u001b[39m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\r\u001b[14d"]
[2821.125083, "o", "\u001b[39m\u001b(B\u001b[mBASE_URL = \u001b(B\u001b[0;1m\u001b[32m'http://{0}/restconf/api/running/'\u001b[39m\u001b(B\u001b[m.format(HOST)\r\u001b[16d"]
[2821.12552, "o", "\u001b(B\u001b[0;1m\u001b[31m# Function to set interface\r\u001b[17d"]
[2821.125949, "o", "\u001b[36mdef\u001b[34m set_interfaces\u001b[39m\u001b(B\u001b[m(append_url, interface_name):\u001b[18;4H"]
[2821.126424, "o", "\u001b(B\u001b[0;1m\u001b[31m # Construct the full URL\u001b[19;5H"]
[2821.12687, "o", "\u001b[39m\u001b(B\u001b[murl = BASE_URL + append_url + interface_name\r\u001b[20d"]
[2821.127342, "o", "\u001b[42m    \u001b[21d\b"]
[2821.127784, "o", "\u001b(B\u001b[0;1m\u001b[31m # Authentication and headers\u001b[22;5H"]
[2821.128212, "o", "\u001b[39m\u001b(B\u001b[mauth = HTTPBasicAuth(USER, PASS)\u001b[23;5H"]
[2821.128668, "o", "headers = {\u001b[24;9H"]
