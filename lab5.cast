[2494.541638, "o", "\u001b(B\u001b[0;1m\u001b[32m'Content-Type'\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'application/vnd.yang.data+json'\u001b[23;5H"]
[2494.54206, "o", "\u001b[39m\u001b(B\u001b[m}\u001b[24d\b"]
[2494.542533, "o", "data = {\u001b[25;9H"]
[2494.54296, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-interfaces:interface\"\u001b[39m\u001b(B\u001b[m: {\u001b[26;13H"]
[2494.543413, "o", "\u001b(B\u001b[0;1m\u001b[32m\"name\"\u001b[39m\u001b(B\u001b[m: interface_name,\u001b[27;13H"]
[2494.543838, "o", "\u001b(B\u001b[0;1m\u001b[32m\"description\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"Changed through Restconf\"\u001b[39m\u001b(B\u001b[m,\u001b[28;13H"]
[2494.544249, "o", "\u001b(B\u001b[0;1m\u001b[32m\"type\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m\"iana-if-type:ethernetCsmacd\"\u001b[39m\u001b(B\u001b[m,\u001b[29;13H"]
[2494.544695, "o", "\u001b(B\u001b[0;1m\u001b[32m\"enabled\"\u001b[39m\u001b(B\u001b[m: \u001b(B\u001b[0;1m\u001b[32m'true'\u001b[39m\u001b(B\u001b[m,\u001b[30;13H"]
[2494.545135, "o", "\u001b(B\u001b[0;1m\u001b[32m\"ietf-ip:ipv4\"\u001b[39m\u001b(B\u001b[m: {\u001b[31;17H"]
[2494.545538, "o", "\u001b(B\u001b[0;1m\u001b[32m\"address\"\u001b[39m\u001b(B\u001b[m: [\u001b[32;21H"]
