[1376.490439, "o", "\r\n"]
[1376.954254, "o", "module: ietf-routing"]
[1376.955069, "o", "\r\n"]
[1376.955532, "o", "  +--ro routing-state"]
[1376.955887, "o", "\r\n"]
[1376.956321, "o", "  |  +--ro routing-instance* [name]"]
[1376.956738, "o", "\r\n"]
[1376.957141, "o", "  |     +--ro name                 string"]
[1376.957538, "o", "\r\n"]
[1376.957936, "o", "  |     +--ro type?                identityref"]
[1376.958289, "o", "\r\n"]
[1376.958752, "o", "  |     +--ro router-id?           yang:dotted-quad"]
[1376.959102, "o", "\r\n"]
[1376.959562, "o", "  |     +--ro interfaces"]
[1376.959923, "o", "\r\n"]
[1376.960416, "o", "  |     |  +--ro interface*   if:interface-state-ref"]
[1376.960802, "o", "\r\n"]
[1376.961269, "o", "  |     +--ro routing-protocols"]
[1376.961683, "o", "\r\n"]
[1376.962182, "o", "  |     |  +--ro routing-protocol* [type name]"]
[1376.962582, "o", "\r\n"]
[1376.96305, "o", "  |     |     +--ro type    identityref"]
[1376.963445, "o", "\r\n"]
[1376.963871, "o", "  |     |     +--ro name    string"]
[1376.964267, "o", "\r\n"]
[1376.964722, "o", "  |     +--ro ribs"]
[1376.965152, "o", "\r\n"]
[1376.965596, "o", "  |        +--ro rib* [name]"]
[1376.965988, "o", "\r\n"]
[1376.966496, "o", "  |           +--ro name              string"]
[1376.96688, "o", "\r\n"]
[1376.967339, "o", "  |           +--ro address-family    identityref"]
[1376.967711, "o", "\r\n"]
[1376.968194, "o", "  |           +--ro default-rib?      boolean {multiple-ribs}?"]
[1376.968592, "o", "\r\n"]
[1376.968921, "o", "  |           +--ro routes"]
[1376.969162, "o", "\r\n"]
[1376.969511, "o", "  |              +--ro route* [destination-prefix]"]
[1376.970184, "o", "\r\n"]
[1376.97053, "o", "  |                 +--ro route-preference?     route-preference"]
[1376.970798, "o", "\r\n"]
[1376.971141, "o", "  |                 +--ro destination-prefix    string"]
[1376.971391, "o", "\r\n"]
[1376.971702, "o", "  |                 +--ro metric?               uint32"]
[1376.971982, "o", "\r\n"]
[1376.97229, "o", "  |                 +--ro next-hop"]
[1376.972538, "o", "\r\n"]
[1376.972893, "o", "  |                 |  +--ro (next-hop-options)"]
[1376.974047, "o", "\r\n"]
[1376.974443, "o", "  |                 |     +--:(simple-next-hop)"]
[1376.974699, "o", "\r\n"]
[1376.975063, "o", "  |                 |     |  +--ro outgoing-interface?   string"]
[1376.975316, "o", "\r\n"]
[1376.975676, "o", "  |                 |     |  +--ro next-hop-address?     string"]
[1376.975931, "o", "\r\n"]
[1376.97624, "o", "  |                 |     +--:(special-next-hop)"]
[1376.976533, "o", "\r\n"]
[1376.976875, "o", "  |                 |        +--ro special-next-hop?     enumeration\r\n"]
[1376.977281, "o", "  |                 +--ro source-protocol       identityref\r\n  |                 +--ro active?               empty"]
[1376.977625, "o", "\r\n  |                 +--ro last-updated?         yang:date-and-time"]
[1376.977877, "o", "\r\n"]
[1376.978285, "o", "  |                 +--ro update-source?        string\r\n  +--rw routing"]
[1376.979891, "o", "\r\n     +--rw routing-instance* [name]"]
[1376.980226, "o", "\r\n        +--rw name                 string"]
[1376.980535, "o", "\r\n        +--rw type?                identityref\r\n"]
[1376.980926, "o", "        +--rw enabled?             boolean\r\n        +--rw router-id?           yang:dotted-quad {router-id}?"]
[1376.98119, "o", "\r\n"]
[1376.98153, "o", "        +--rw description?         string\r\n        +--rw interfaces"]
[1376.981907, "o", "\r\n        |  +--rw interface*   if:interface-ref\r\n        +--rw routing-protocols"]
[1376.982233, "o", "\r\n        |  +--rw routing-protocol* [type name]\r\n"]
[1376.982597, "o", "        |     +--rw type             identityref\r\n        |     +--rw name             string"]
[1376.982918, "o", "\r\n        |     +--rw description?     string"]
[1376.983201, "o", "\r\n        |     +--rw static-routes"]
[1376.983575, "o", "\r\n        +--rw ribs\r\n           +--rw rib* [name]"]
[1376.984131, "o", "\r\n              +--rw name              string"]
[1376.985586, "o", "\r\n"]
[1376.985916, "o", "              +--rw address-family?   identityref"]
[1376.986275, "o", "\r\n              +--rw description?      string"]
[1376.986655, "o", "\r\n\r\n"]
[1376.987112, "o", "  augment /if:interfaces-state/if:interface:\r\n    +--ro routing-instance?   string\r\n\r\n  rpcs:\r\n    +---x fib-route"]
[1376.987433, "o", "\r\n       +---w input"]
[1376.987737, "o", "\r\n       |  +---w routing-instance-name    string"]
[1376.988087, "o", "\r\n       |  +---w destination-address\r\n       |     +---w address-family    identityref"]
[1376.988427, "o", "\r\n       +--ro output\r\n          +--ro route"]
[1376.988743, "o", "\r\n             +--ro address-family     identityref"]
[1376.989053, "o", "\r\n             +--ro next-hop\r\n"]
[1376.989373, "o", "             |  +--ro (next-hop-options)\r\n"]
[1376.9897, "o", "             |     +--:(simple-next-hop)\r\n             |     |  +--ro outgoing-interface?   string"]
[1376.991117, "o", "\r\n             |     |  +--ro next-hop-address?     string\r\n             |     +--:(special-next-hop)"]
[1376.991501, "o", "\r\n             |        +--ro special-next-hop?     enumeration\r\n             +--ro source-protocol    identityref"]
[1376.991809, "o", "\r\n             +--ro active?            empty\r\n"]
[1376.994598, "o", "             +--ro last-updated?      yang:date-and-time\r\n"]
