[2073.409126, "o", "\u001b[49m\u001b(B\u001b[mPASS = \u001b(B\u001b[0;1m\u001b[32m'Meilab123'\u001b(B\u001b[0m\u001b[42m \r\u001b[12d"]
[2073.409546, "o", "\u001b[49m\u001b(B\u001b[mBASE_URL = \u001b(B\u001b[0;1m\u001b[32m'http://{0}/restconf/api/running/'\u001b[39m\u001b(B\u001b[m.format(HOST)\u001b[42m \r\u001b[14d"]
[2073.409982, "o", "\u001b(B\u001b[0;1m\u001b[36mdef\u001b[34m set_interfaces\u001b[39m\u001b(B\u001b[m(append_url, interface_name):\u001b[42m \u001b[15;5H"]
